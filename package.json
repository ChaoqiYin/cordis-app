{
  "name": "cordis-app-monorepo",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "version:sync": "node packages/cordis-app/scripts/sync-version.mjs",
    "build": "pnpm version:sync && pnpm -r --filter \"./packages/**\" --filter \"./examples/**\" run build",
    "build:ui": "pnpm --filter @cordis-app/ui run build",
    "build:kernel": "pnpm --filter @cordis-app/kernel run build",
    "build:runtime": "pnpm --filter @cordis-app/runtime run build",
    "build:preset": "pnpm --filter @cordis-app/preset run build",
    "build:cli": "pnpm --filter @cordis-app/cli run build",
    "stage:ui": "node packages/shell/scripts/stage-resources.mjs",
    "build:shell": "pnpm build:ui && pnpm stage:ui && mkdir -p dist && cd packages/shell && go build -o ../../dist/cordis-app .",
    "test:shell": "cd packages/shell && go test ./...",
    "typecheck": "pnpm -r --filter \"./packages/**\" --filter \"./examples/**\" run typecheck",
    "test": "pnpm -r --filter \"./packages/**\" --filter \"./examples/**\" run test",
    "dev": "pnpm --filter @cordis-app/ui run dev",
    "clean": "rm -rf packages/*/dist packages/*/lib packages/*/node_modules"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "cordis-app": "workspace:*",
    "typescript": "^5.9.3"
  }
}
