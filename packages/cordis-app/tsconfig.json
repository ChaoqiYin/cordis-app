{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "lib",
    "rootDir": "src",
    "composite": true,
    "declaration": true,
    "paths": {
      "cordis-app/client": [
        "./src/client.ts"
      ],
      "cordis-app/ui": [
        "./src/ui.ts"
      ]
    }
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "../kernel"
    },
    {
      "path": "../preset"
    },
    {
      "path": "../protocol"
    },
    {
      "path": "../runtime"
    }
  ]
}
