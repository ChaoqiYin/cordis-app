{
  "name": "@cordis-app/cli",
  "version": "1.0.0",
  "description": "Command line: new / add / remove / run / restart",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "bin": {
    "cordis-app-cli": "./lib/cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json && node -e \"require('node:fs').chmodSync('lib/cli.js', 0o755)\"",
    "typecheck": "tsc -b tsconfig.json",
    "test": "tsc -b tsconfig.json && node --test \"test/*.test.ts\""
  },
  "dependencies": {
    "@cordis-app/protocol": "workspace:*",
    "@cordis-app/runtime": "workspace:*",
    "@cordis-app/ui": "workspace:*"
  },
  "devDependencies": {
    "@cordis-app/preset": "workspace:*",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3"
  }
}
