{
  "name": "@cordis-app/ui",
  "version": "1.0.0",
  "description": "React web UI skeleton: layout, five extension points, settings panel",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/shared/client.js",
  "types": "./dist/shared/client.d.ts",
  "exports": {
    ".": {
      "types": "./dist/shared/client.d.ts",
      "default": "./dist/shared/client.js"
    },
    "./ui": "./dist/ui/",
    "./shared": "./dist/shared/",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-shared.mjs && vite build && tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/*.test.ts\""
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@cordis-app/protocol": "workspace:*",
    "axios": "^1.21.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
