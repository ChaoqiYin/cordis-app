{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "cordis-app/client": [
        "./src/client/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "shared-modules.mjs",
    "vite.config.ts"
  ]
}
